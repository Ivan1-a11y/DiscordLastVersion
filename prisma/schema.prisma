// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ChannelType {
  TEXT
  VOICE
}

model User {
  id            String      @id @default(cuid())
  username      String      @unique
  tag           String      // 4-digit discriminator e.g. "1337"
  displayName   String
  email         String      @unique
  passwordHash  String
  avatarUrl     String?
  bannerUrl     String?
  bio           String?
  status        UserStatus  @default(ONLINE)
  customStatus  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relationships
  ownedServers          Server[]            @relation("ServerOwner")
  memberships           Member[]
  sentFriendRequests    FriendRequest[]     @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]    @relation("ReceivedFriendRequests")
  friendshipsInitiated  Friendship[]        @relation("UserInitiatedFriendships")
  friendshipsReceived   Friendship[]        @relation("UserReceivedFriendships")
  blockedUsersInitiated BlockedUser[]       @relation("UserInitiatedBlocks")
  blockedByUsers        BlockedUser[]       @relation("UserBlockedBy")
  serverMessages        ServerMessage[]
  sentDirectMessages    DirectMessage[]     @relation("SentDMs")
  receivedDirectMessages DirectMessage[]    @relation("ReceivedDMs")
  reactions             Reaction[]

  @@unique([username, tag])
  @@index([username])
}

model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender      User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId1   String
  userId2   String
  createdAt DateTime @default(now())

  user1     User     @relation("UserInitiatedFriendships", fields: [userId1], references: [id], onDelete: Cascade)
  user2     User     @relation("UserReceivedFriendships", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("UserInitiatedBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Server {
  id          String      @id @default(cuid())
  name        String
  iconUrl     String?
  description String?
  inviteCode  String      @unique
  ownerId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner       User        @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     Member[]
  roles       Role[]
  categories  Category[]
  channels    Channel[]

  @@index([inviteCode])
}

model Role {
  id          String    @id @default(cuid())
  serverId    String
  name        String
  color       String    @default("#99AAB5") // Hex color
  hoist       Boolean   @default(false)     // Display role members separately
  position    Int       @default(0)
  
  // Permissions boolean flags
  manageChannels  Boolean @default(false)
  kickMembers     Boolean @default(false)
  banMembers      Boolean @default(false)
  sendMessages    Boolean @default(true)
  connectVoice    Boolean @default(true)
  administrator   Boolean @default(false)

  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     MemberRole[]

  @@index([serverId])
}

model Member {
  id        String       @id @default(cuid())
  serverId  String
  userId    String
  nickname  String?
  joinedAt  DateTime     @default(now())

  server    Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MemberRole[]

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
}

model MemberRole {
  memberId  String
  roleId    String

  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

model Category {
  id        String    @id @default(cuid())
  serverId  String
  name      String
  order     Int       @default(0)

  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@index([serverId])
}

model Channel {
  id          String      @id @default(cuid())
  serverId    String
  categoryId  String?
  name        String
  type        ChannelType @default(TEXT)
  topic       String?
  order       Int         @default(0)
  isPrivate   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages    ServerMessage[]

  @@index([serverId])
}

model ServerMessage {
  id          String      @id @default(cuid())
  channelId   String
  authorId    String
  content     String
  attachments Json?       // [{ url, name, size, type }]
  replyToId   String?
  isEdited    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     ServerMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ServerMessage[] @relation("MessageReplies")
  reactions   Reaction[]  @relation("ServerMessageReactions")

  @@index([channelId, createdAt])
}

model DirectMessage {
  id          String      @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  attachments Json?       // [{ url, name, size, type }]
  replyToId   String?
  isEdited    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender      User        @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo     DirectMessage? @relation("DirectMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     DirectMessage[] @relation("DirectMessageReplies")
  reactions   Reaction[]  @relation("DirectMessageReactions")

  @@index([senderId, receiverId, createdAt])
}

model Reaction {
  id              String         @id @default(cuid())
  emoji           String
  userId          String
  serverMessageId String?
  directMessageId String?
  createdAt       DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverMessage   ServerMessage? @relation("ServerMessageReactions", fields: [serverMessageId], references: [id], onDelete: Cascade)
  directMessage   DirectMessage? @relation("DirectMessageReactions", fields: [directMessageId], references: [id], onDelete: Cascade)

  @@index([serverMessageId])
  @@index([directMessageId])
}
